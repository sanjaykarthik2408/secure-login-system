# Use a long, random secret in production (for example: openssl rand -base64 48)
SESSION_SECRET=replace-with-a-long-random-session-secret
PORT=3000
NODE_ENV=development

# SQLite database location. Keep it outside source control.
DATABASE_PATH=./data/app.db

# Set true only when the app is served exclusively over HTTPS (production).
COOKIE_SECURE=false
